{
  "name": "sketchforge",
  "version": "2.6.0",
  "description": "Layered drawing and frame-by-frame animation studio for desktop, phone and tablet.",
  "main": "main.js",
  "author": "Sketchforge",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "serve": "npx serve .",
    "dist": "electron-builder --publish never",
    "build": "python3 build.py",
    "build:models": "node tools/build_models.mjs",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "build:www": "node tools/build_www.mjs",
    "android": "node tools/build_www.mjs && npx cap sync android",
    "build:site": "node tools/build_site.mjs"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "three": "0.170.0",
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/share": "^6.0.2"
  },
  "build": {
    "appId": "app.sketchforge.studio",
    "productName": "Sketchforge",
    "files": [
      "main.js",
      "index.html",
      "style.css",
      "app.js",
      "cloud-config.js",
      "cloud-lib.js",
      "three3d.js",
      "models3d.js",
      "sw.js",
      "manifest.json",
      "icon.svg",
      "icon-192.png",
      "icon-512.png",
      "THREE-LICENSE.txt"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon-512.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "icon-512.png",
      "category": "public.app-category.graphics-design",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "icon-512.png",
      "category": "Graphics"
    },
    "artifactName": "Sketchforge-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": null,
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sketchforge",
      "artifactName": "Sketchforge-Setup-${version}.${ext}"
    },
    "dmg": {
      "artifactName": "Sketchforge-${version}-mac-${arch}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "sketchforge",
        "name": "Sketchforge drawing",
        "role": "Editor"
      }
    ]
  },
  "sketchforge": {
    "releasesRepo": "Akarulvm777/Sketchforge",
    "minShell": "2.4.0",
    "mac": false
  }
}
